{
  "openapi": "3.0.4",
  "info": {
    "title": "API InmoPlus",
    "description": "CRUD contactos InmoPlus",
    "contact": {
      "name": "InmoPlus.com",
      "url": "https://inmoplus.es/contacto",
      "email": "info@inmoplus.es"
    },
    "license": {
      "name": "MIT License",
      "url": "https://inmoplus.es/avisolegal"
    },
    "version": "v1"
  },
  "paths": {
    "/contactos/BuscarContactos": {
      "get": {
        "tags": [
          "Contactos"
        ],
        "summary": "Devuelve lista de contactos para búsquedas rápidas",
        "operationId": "BuscarContactos",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "description": "Texto a buscar en nombre, apellidos, teléfono, email, dni",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/API_BuscarContactos"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
