  "paths": {
    "/usuarios/ListadoUsuariosDisponibles": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Devuelve lista de usuarios disponibles",
        "operationId": "ListadoUsuariosDisponibles",
        "parameters": [
          {
            "name": "texto",
            "in": "query",
            "description": "Buscar por nombre, mail, teléfono o nif",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Captadores",
            "in": "query",
            "description": "Solo usuarios con rol de captador",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Vendedores",
            "in": "query",
            "description": "Solo usuarios con rol de vendedor",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "orden",
            "in": "query",
            "description": "Ordenar por campo",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dirOrden",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numpage",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListadoUsuariosCortoDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
