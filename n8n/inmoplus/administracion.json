  "paths": {
    "/administracion/ListadoLeads": {
      "get": {
        "tags": [
          "Leads"
        ],
        "summary": "Devuelve lista de Leads recibidos",
        "operationId": "ListadoLeads",
        "parameters": [
          {
            "name": "FechaIni",
            "in": "query",
            "description": "Formato dd/MM/yyyy. Fecha desde",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FechaFin",
            "in": "query",
            "description": "Formato dd/MM/yyyy. Fecha hasta",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Valorado",
            "in": "query",
            "description": "Comprobar si se ha realizado valoración. 0 = todos, 1 = valorados, 2 = no valorados",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Origen",
            "in": "query",
            "description": "Fuente del lead. buscar que el origen contenga el texto indicado. \"buscocasa, idealista, fotocasa, etc\"",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "orden",
            "in": "query",
            "description": "Ordenar por columna",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dirOrden",
            "in": "query",
            "description": "Dirección del orden. ASC o DESC",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numpage",
            "in": "query",
            "description": "Número de página",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "Número de registros por página",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListadoValoraciones"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
