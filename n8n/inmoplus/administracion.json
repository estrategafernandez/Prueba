              "type": "string"
            }
          },
          {
            "name": "FechaTarea2",
            "in": "query",
            "description": "Formato dd/MM/yyyy. Fecha hasta",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Estado",
            "in": "query",
            "description": "Estado de la gestión. Revisar /valores/EstadoGestion",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Usuario",
            "in": "query",
            "description": "Id del usuario que realiza la gestión. Admite lista de ids separados por coma",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Contacto",
            "in": "query",
            "description": "Id de contacto.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "Inmueble",
            "in": "query",
            "description": "Id de inmueble.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "orden",
            "in": "query",
            "description": "Ordenar por columna",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dirOrden",
            "in": "query",
            "description": "Dirección del orden. ASC o DESC",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "numpage",
            "in": "query",
            "description": "Número de página",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "description": "Número de registros por página",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaEstadoDto"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListadoGestionesAgenda"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
