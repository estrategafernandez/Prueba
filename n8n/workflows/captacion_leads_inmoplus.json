   "name": "Datos del inmueble"
  },
  {
   "parameters": {
    "jsCode": "// InmoPlus marca la operacion en el propio inmueble: nVenta y nAlquiler.\n// Un inmueble puede estar en las dos; en ese caso mandamos la de compra,\n// que es la que la agencia prioriza para un lead sin mas contexto.\nconst lead = $('Campos del lead').item.json;\nconst resp = $input.first().json || {};\nconst inm = (resp.inmuebles || [])[0] || {};\n\nconst venta    = Number(inm.nVenta ?? 0) > 0;\nconst alquiler = Number(inm.nAlquiler ?? 0) > 0;\nconst operacion = venta ? 'compra' : (alquiler ? 'alquiler' : 'compra');\n\n// Descripcion corta del inmueble para la variable de la plantilla.\nconst descripcion = String(\n  inm.cTituloWeb || inm.cTitulo || inm.cTipoInmueble || ''\n).replace(/\\s+/g, ' ').trim() || ('referencia ' + lead.referencia);\n\n// PLANTILLAS DE META. Ajustar aqui si cambian los nombres o las variables.\n// Ojo: Meta rechaza variables con saltos de linea, tabuladores o mas de\n// cuatro espacios seguidos (error 132000), por eso se aplana todo.\nconst aplana = (t) => String(t ?? '').replace(/[\\r\\n\\t]+/g, ' ').replace(/\\s{2,}/g, ' ').trim().slice(0, 900);\nconst PLANTILLAS = {\n  compra:   { nombre: 'plantilla_compra',   idioma: 'en', etiqueta: 'compra' },\n  alquiler: { nombre: 'plantilla_alquiler', idioma: 'en', etiqueta: 'alquiler' },\n};\nconst p = PLANTILLAS[operacion];\n\nreturn [{ json: {\n  ...lead,\n  operacion,\n  descripcion_inmueble: aplana(descripcion),\n  plantilla: p.nombre,\n  idioma: p.idioma,\n  etiqueta_operacion: p.etiqueta,\n  param1: aplana(lead.nombre_corto),\n  param2: aplana(descripcion),\n}}];"
   },
