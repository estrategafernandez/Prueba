  {
   "parameters": {
    "jsCode": "// Normaliza cada lead de InmoPlus a los campos que usa el resto del escenario.\nconst salida = [];\nfor (const it of $input.all()) {\n  const l = it.json;\n  // El telefono llega partido en prefijo y numero, y a veces con ruido.\n  let tel = String(l.cTelefono ?? '').replace(/[^0-9+]/g, '');\n  const pref = String(l.cPrefijo ?? '').replace(/[^0-9]/g, '');\n  if (tel.startsWith('+')) tel = tel.slice(1);\n  if (/^\\d{9}$/.test(tel)) tel = (pref || '34') + tel;   // espanol sin prefijo\n  tel = tel.replace(/^00/, '');\n\n  const nombre = [l.cNombre, l.cApellidos].filter(Boolean).join(' ').trim();\n  salida.push({ json: {\n    uid: l.cUid ?? '',\n    id_inmueble: l.idInmueble ?? null,\n    referencia: l.cReferencia || l.cReferenciaPropia || '',\n    nombre_completo: nombre || 'Cliente',\n    nombre_corto: (nombre.split(' ')[0] || 'Cliente'),\n    email: l.cEmail ?? '',\n    wa_id: tel,\n    telefono_mas: '+' + tel,\n    fecha: l.dFechaHora ?? '',\n    // Texto integro del correo del portal. InmoPlus ya lo ingiere, por eso no\n    // hace falta conectarse a info@.\n    correo_origen: l.cTextoMailOrigen ?? '',\n    portal: l.cMailOrigen ?? '',\n  }});\n}\nreturn salida;"
   },
