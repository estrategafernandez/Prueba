  {
   "parameters": {
    "jsCode": "// Destinatarios del aviso interno. AÑADIR AQUI LOS TELEFONOS REALES.\n// El telefono va en formato internacional sin el signo +  (ej. 34600111222).\nconst DESTINATARIOS = [\n  { nombre: 'Alejandro',      telefono: 'PENDIENTE_ALEJANDRO' },\n  { nombre: 'María Ángeles',  telefono: 'PENDIENTE_MARIA_ANGELES' },\n];\n\nconst e = $input.first().json;\n\n// WhatsApp RECHAZA variables de plantilla que contengan saltos de linea,\n// tabuladores o mas de 4 espacios seguidos (error 132000). Un resumen de\n// conversacion es multilinea por naturaleza, asi que hay que aplanarlo.\nconst aplana = (t) => String(t ?? '')\n  .replace(/\\r/g, ' ')\n  .replace(/\\n+/g, ' · ')\n  .replace(/\\t/g, ' ')\n  .replace(/\\s{2,}/g, ' ')\n  .trim();\n\nconst trozos = [];\nif (e.operacion)        trozos.push(`Operación: ${aplana(e.operacion)}`);\nif (e.inmueble)         trozos.push(`Inmueble: ${aplana(e.inmueble)}`);\nif (e.nombre_cliente)   trozos.push(`Cliente: ${aplana(e.nombre_cliente)}`);\nif (e.telefono_cliente) trozos.push(`Teléfono: ${aplana(e.telefono_cliente)}`);\nif (e.resumen)          trozos.push(`Resumen: ${aplana(e.resumen)}`);\nif (e.disponibilidad)   trozos.push(`Disponibilidad: ${aplana(e.disponibilidad)}`);\n\nlet contenido = trozos.join(' — ');\n\n// Limite de Meta por variable: 1024 caracteres. Se recorta con margen.\nconst MAX = 900;\nif (contenido.length > MAX) contenido = contenido.slice(0, MAX - 1) + '…';\nif (!contenido) contenido = 'Nuevo lead cualificado. Revisa la conversación en el panel.';\n\nconst pendientes = DESTINATARIOS.filter(d => d.telefono.startsWith('PENDIENTE'));\nif (pendientes.length === DESTINATARIOS.length) {\n  throw new Error('AVISO: no hay ningun telefono configurado en el nodo Destinatarios del aviso.');\n}\n\nreturn DESTINATARIOS\n  .filter(d => !d.telefono.startsWith('PENDIENTE'))\n  .map(d => ({ json: { ...d, contenido, wa_id: String(d.telefono).replace(/[^0-9]/g, '') } }));"
   },
