st detalles = [hab, ban, sup].filter(Boolean).join(', ');\n  const caract = d.caracteristicas ? `Características: ${d.caracteristicas}.` : '';\n  const desc = d.descripcion \n    ? `Descripción: ${d.descripcion.replace(/\\\\r\\\\n|\\\\r|\\\\n|\\r\\n|\\r|\\n/g, ' ').trim()}.` \n    : '';\n  return `Opción ${i+1}: ${d.tipo_inmueble}${zona}, referencia ${d.ref}, ${detalles}, ${precio}. ${caract} ${desc}`;\n}).join(' | ');\n\nconst total = items.length > 5 ? ` He encontrado ${items.length} en total, ordenados de menor a mayor precio, y te muestro los 5 más económicos.` : '';\n\nreturn [{ json: { result: `He encontrado ${items.length} inmueble${items.length !== 1 ? 's' : ''}.${total} ${lista}` } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[720,64],"id":"98cf10de-cf2a-4acb-bc8e-658cb1627d4c","name":"FormatearSalidaParaAgenteTelefónico"}],"connections":{"Webhook":{"main":[[{"node":"BuscarInmuebles","type":"main","index":0}]]},"BuscarInmuebles":{"main":[[{"node":"FiltrarHabitacionesMunicipio","type":"main","index":0}]]},"FiltrarHabitacionesMunicipio":{"main":[[{"node":"FormatearSalidaParaAgenteTelefónico","type":"main","index":0}]]},"FormatearSalidaParaAgenteTelefónico":{"main":[[{"node":"Respond to Webhook","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","binaryMode":"separate","availableInMCP":false},"staticData":null,"meta":{"templateCredsSetupCompleted":true},"pinData":{"Webhook":[{"json":{"headers":{"host":"n8n-casagencia.serversvisionarius.com","user-agent":"axios/1.15.2","content-length":"91","accept":"application/json, text/plain, */*","accept-encoding":"gzip, compress, deflate, br","baggage":"sentry-environment=production,sentry-public_key=f9776ac2f798b66bdadc990a2ed64f17,sentry-trace_id=d44cf49476844943a0dc514fdd1e11fa,sentry-org_id=4511141371183104","content-type":"application/json","sentry-trace":"d44cf49476844943a0dc514fdd1e11fa-88a3cdb210cba7a9","x-forwarded-for":"100.20.5.228","x-forwarded-host":"n8n-casagencia.serversvisionar