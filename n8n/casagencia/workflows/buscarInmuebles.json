    {
      "parameters": {
        "jsCode": "// alwaysOutputData en el Filter hace que n8n mande un item vacio cuando no\n// hay resultados. Sin ese item, este nodo y el Respond no llegaban a\n// ejecutarse y Retell recibia una respuesta vacia.\nconst items = $input.all().filter(i => i.json && i.json.ref);\n\nif (items.length === 0) {\n  return [{ json: { result: \"No he encontrado inmuebles con esos criterios de búsqueda.\" } }];\n}\n\n// Ordena por precio ascendente. Los que no tienen precio van al final.\nconst ordenados = [...items].sort((a, b) => {\n  const pa = Number(a.json.precio) || Infinity;\n  const pb = Number(b.json.precio) || Infinity;\n  return pa - pb;\n});\n\n// devuelve solo los 5 primeros inmuebles (los mas baratos)\nconst limitados = ordenados.slice(0, 5);\n\nconst lista = limitados.map((item, i) => {\n  const d = item.json;\n  const precio = d.precio ? `${Number(d.precio).toLocaleString('es-ES')}€` : 'precio a consultar';\n  const hab = d.habitaciones ? `${d.habitaciones} habitaciones` : '';\n  const ban = d.banos ? `${d.banos} baños` : '';\n  const sup = d.superficie && d.superficie > 0 ? `${d.superficie}m²` : '';\n  const zona = d.zona ? ` en ${d.zona}` : '';\n  const detalles = [hab, ban, sup].filter(Boolean).join(', ');\n  const caract = d.caracteristicas ? `Características: ${d.caracteristicas}.` : '';\n  const desc = d.descripcion \n    ? `Descripción: ${d.descripcion.replace(/\\\\r\\\\n|\\\\r|\\\\n|\\r\\n|\\r|\\n/g, ' ').trim()}.` \n    : '';\n  return `Opción ${i+1}: ${d.tipo_inmueble}${zona}, referencia ${d.ref}, ${detalles}, ${precio}. ${caract} ${desc}`;\n}).join(' | ');\n\nconst total = items.length > 5 ? ` He encontrado ${items.length} en total, ordenados de menor a mayor precio, y te muestro los 5 más económicos.` : '';\n\nreturn [{ json: { result: `He encontrado ${items.length} inmueble${items.length !== 1 ? 's' : ''}.${total} ${lista}` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
