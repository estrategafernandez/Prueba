    "jsCode": "for (const item of $input.all()) {\n  // Obtener el teléfono\n  let wa_id = item.json.cTelefono;\n\n  // Convertir a string y limpiar espacios/guiones\n  wa_id = String(wa_id).replace(/[\\s-]/g, '');\n\n  if (wa_id.startsWith('+')) {\n    // Quitar el +\n    wa_id = wa_id.substring(1);\n\n    // Si después de quitar el + quedan 9 dígitos,\n    // asumimos que es un número español sin prefijo\n    if (/^\\d{9}$/.test(wa_id)) {\n      wa_id = '34' + wa_id;\n    }\n  } else if (/^\\d{9}$/.test(wa_id)) {\n    // Número español sin prefijo\n    wa_id = '34' + wa_id;\n  }\n  // Si ya tiene un prefijo internacional (34, 40, 44, etc.), no hacer nada\n\n  item.json.processed_wa_id = wa_id;\n}\n\nreturn $input.all();"
   },
