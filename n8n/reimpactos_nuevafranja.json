      "id": "b656ca36-86e8-42d7-9320-70631528d692",
      "name": "RecogerMensajesConversacion",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1380,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===================================================================\n//  CADENCIA \"NUEVA FRANJA\"\n//  Dias contados desde el Dia 1 (envio de la plantilla inicial).\n//    Dia 1  -> z_plantilla_enviada_meta   (la envia otro workflow)\n//    Dia 2  -> R1 -> z_reimpacto1_meta\n//    Dia 4  -> R2 -> z_reimpacto2_meta\n//    Dia 7  -> R3 -> z_reimpacto3_meta\n//    Dia 10 -> R4 -> z_reimpacto4_meta\n//    Dia 14 -> R5 -> z_reimpacto5_meta\n//    Dia 20 -> R6 -> z_reimpacto6_meta    (cierre, no hay mas reimpactos)\n//  La espera de cada paso se deduce restando los dias de dos fases\n//  consecutivas, asi que para cambiar la cadencia basta con tocar\n//  los numeros de este mapa.\n// ===================================================================\nconst DIA_DE_LA_FASE = {\n  'z_plantilla_enviada_meta': 1,\n  'z_reimpacto1_meta': 2,\n  'z_reimpacto2_meta': 4,\n  'z_reimpacto3_meta': 7,\n  'z_reimpacto4_meta': 10,\n  'z_reimpacto5_meta': 14,\n  'z_reimpacto6_meta': 20,\n};\n\n// Franja horaria en la que se permite enviar plantillas (hora local de Espana).\n// Ambas horas ESTAN INCLUIDAS: con 9 y 20 se envia desde las 09:00 hasta las 20:59,\n// y como el disparador es horario, el ultimo envio real cae a las 20:00.\n// Nunca se envia de noche. Pon FRANJA_ACTIVA en false para quitar la restriccion.\nconst FRANJA_ACTIVA       = true;\nconst FRANJA_PRIMERA_HORA = 9;   // incluida\nconst FRANJA_ULTIMA_HORA  = 20;  // incluida\nconst ZONA_HORARIA        = 'Europe/Madrid';\n\n// Si el lead ha escrito despues de nuestro ultimo impacto, se detiene la secuencia.\nconst PARAR_SI_EL_LEAD_RESPONDE = true;\n\nconst SECUENCIA = Object.keys(DIA_DE_LA_FASE);\n\nconst conversacion = $('Por Cada Conversacion').first().json;\nconst etiquetas    = $('RecogerEtiquetasExistentes').first().json.payload || [];\nconst mensajes     = $input.first().json.payload || [];\n\nconst base = {\n  conversation_id: conversacion.id,\n  account_id: conversacion.account_id,\n  telefono: conversacion.meta?.sender?.phone_number ?? null,\n  etiquetas_actuales: etiquetas,\n};\nconst salida = (enviar, motivo, extra) => [{ json: { ...base, enviar, motivo, ...(extra || {}) } }];\n\n// --- 1. Fase actual: la etiqueta mas avanzada de la secuencia que tiene ahora mismo.\nconst faseActual = [...SECUENCIA].reverse().find(l => etiquetas.includes(l));\nif (!faseActual) {\n  return salida(false, 'La conversacion ya no tiene ninguna etiqueta de la secuencia.');\n}\n\n// --- 2. Siguiente fase. Si no hay, la secuencia esta cerrada (ya tiene z_reimpacto6_meta).\nconst siguienteFase = SECUENCIA[SECUENCIA.indexOf(faseActual) + 1];\nif (!siguienteFase) {\n  return salida(false, `Secuencia terminada: ya se envio el ultimo reimpacto (${faseActual}).`);\n}\n\n// --- 3. Momento en que entro en la fase actual.\n// Chatwoot deja un mensaje de actividad (message_type 2) cada vez que se anade una etiqueta;\n// ese es el sello de tiempo exacto del cambio de fase y no lo alteran las notas internas.\nconst actividadesDeLaFase = mensajes.filter(m =>\n  m.message_type === 2 && typeof m.content === 'string' && m.content.includes(faseActual)\n);\nlet inicioFase = actividadesDeLaFase.length\n  ? Math.max(...actividadesDeLaFase.map(m => m.created_at))\n  : null;\nlet origenDelReloj = 'actividad de la etiqueta';\n\n// Reserva: si la actividad ya no esta en el historial reciente, usamos el ultimo mensaje real.\nif (!inicioFase) {\n  inicioFase = conversacion.last_non_activity_message?.created_at\n            ?? conversacion.last_activity_at;\n  origenDelReloj = 'ultimo mensaje de la conversacion (no se encontro la actividad de la etiqueta)';\n}\nif (!inicioFase) {\n  return salida(false, 'No se ha podido determinar desde cuando esta el lead en esta fase.');\n}\n\n// --- 4. El lead ha respondido despues de nuestro ultimo impacto?\nconst respondio = mensajes.some(m =>\n  m.message_type === 0 && m.private !== true && m.created_at > inicioFase\n);\n\n// --- 5. Cuentas de tiempo (un unico instante para todo el calculo).\nconst ahoraMs         = Date.now();\nconst ahora           = Math.floor(ahoraMs / 1000);\nconst horasEnFase     = (ahora - inicioFase) / 3600;\nconst diasDeEspera    = DIA_DE_LA_FASE[siguienteFase] - DIA_DE_LA_FASE[faseActual];\nconst horasNecesarias = diasDeEspera * 24;\n\n// --- 6. Franja horaria.\nconst horaLocal = Number(new Intl.DateTimeFormat('en-GB', {\n  timeZone: ZONA_HORARIA, hour: '2-digit', hourCycle: 'h23',\n}).format(new Date(ahoraMs)));\nconst dentroDeFranja = !FRANJA_ACTIVA || (horaLocal >= FRANJA_PRIMERA_HORA && horaLocal <= FRANJA_ULTIMA_HORA);\n\n// --- 7. Etiquetas que quedarian tras el envio.\nconst nuevasEtiquetas = etiquetas.filter(l => l !== faseActual).concat(siguienteFase);\n\nconst detalle = {\n  fase_actual: faseActual,\n  fase_reimpacto: siguienteFase,\n  dias_de_espera: diasDeEspera,\n  dias_en_fase: Number((horasEnFase / 24).toFixed(2)),\n  horas_en_fase: Math.floor(horasEnFase),\n  horas_necesarias: horasNecesarias,\n  inicio_fase: new Date(inicioFase * 1000).toISOString(),\n  origen_del_reloj: origenDelReloj,\n  hora_local: horaLocal,\n  nuevas_etiquetas: nuevasEtiquetas,\n  body_labels: JSON.stringify({ labels: nuevasEtiquetas }),\n};\n\nif (PARAR_SI_EL_LEAD_RESPONDE && respondio) {\n  return salida(false, 'El lead ha respondido despues del ultimo impacto: no se reimpacta.', detalle);\n}\nif (horasEnFase < horasNecesarias) {\n  const restan = ((horasNecesarias - horasEnFase) / 24).toFixed(2);\n  return salida(false, `Todavia no toca: lleva ${detalle.dias_en_fase} de ${diasDeEspera} dias (faltan ${restan}).`, detalle);\n}\nif (!dentroDeFranja) {\n  return salida(false, `Fuera de la franja de envio (${FRANJA_PRIMERA_HORA}:00-${FRANJA_ULTIMA_HORA}:00, son las ${horaLocal}:00).`, detalle);\n}\n\nreturn salida(true, `Toca ${siguienteFase} tras ${detalle.dias_en_fase} dias en ${faseActual}.`, detalle);\n"
      },
