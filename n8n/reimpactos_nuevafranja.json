    {
      "parameters": {
        "jsCode": "// Recursos de cada plantilla de reimpacto.\n// video vacio = la plantilla es solo texto y se envia sin cabecera.\nconst VIDEOS = {\n  1: 'https://drive.google.com/uc?export=download&id=1XBoN9Vd8YwK9-ZL140qa3aQTqhVekE78',\n  2: 'https://drive.google.com/uc?export=download&id=1ek3jKFkkPdDDQMUloD83YQ0tnvhR7K08',\n  3: 'https://drive.google.com/uc?export=download&id=1jWkhDgl3gva1W6n0IxzeGZsH089NX6bW',\n  4: 'https://drive.google.com/uc?export=download&id=1A63jZDo1ZqIkHJ6rnUoFUHhww6sc_Uv3',\n  5: 'https://drive.google.com/uc?export=download&id=1TomqEHWP-hjCBPn1MJlO3b2hS-OwynXP',\n  6: '',\n};\n\nconst IDIOMAS = {\n  1: 'es',\n  2: 'es',\n  3: 'es',\n  4: 'en', // TEMPORAL: reimpacto4 esta registrada en Meta como ingles, pendiente de correccion.\n  5: 'es',\n  6: 'es',\n};\n\nconst items = $input.all();\n\nfor (const item of items) {\n  const encontrado = String(item.json.fase_reimpacto || '').match(/z_reimpacto(\\d)_meta/);\n  const n = encontrado ? Number(encontrado[1]) : null;\n\n  item.json.numero_reimpacto = n;\n  item.json.nombre_plantilla = 'reimpacto' + n;\n  item.json.video_drive_url  = VIDEOS[n] || '';\n  item.json.idioma           = IDIOMAS[n] || 'es';\n}\n\nreturn items;\n"
      },
