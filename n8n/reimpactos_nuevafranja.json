    {
      "parameters": {
        "jsCode": "// Texto real que ha recibido el lead, para dejarlo como nota interna en Chatwoot.\nconst respuesta = $input.first().json;\nconst nombre    = $('PrepararEnvioReimpacto').first().json.nombre_plantilla;\n\nconst plantillas = respuesta.data || [];\nconst plantilla  = plantillas.find(p => p.name === nombre) || plantillas[0];\nconst cuerpo     = plantilla?.components?.find(c => c.type === 'BODY')?.text || '';\n\nreturn [{ json: { nombre_plantilla: nombre, textoPlantilla: cuerpo } }];\n"
      },
      "id": "7175d8e3-eac3-4d1b-b167-a278e143a19c",
      "name": "ExtraerTextoPlantilla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3360,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const conversacion = $('Por Cada Conversacion').first().json;\nconst envio        = $('PrepararEnvioReimpacto').first().json;\nconst inboxId      = conversacion.inbox_id ?? conversacion.messages?.[0]?.inbox_id;\n\n// Titulo de la nota interna: \"SEGUIMIENTO 1\" para R1, \"SEGUIMIENTO 2\" para R2...\n// En negrita, porque Chatwoot interpreta markdown en las notas.\nconst titulo = '**SEGUIMIENTO ' + envio.numero_reimpacto + '**';\n\nconst items = $input.all();\n\nfor (const item of items) {\n  item.json.titulo_nota    = titulo;\n  item.json.fase_reimpacto = envio.fase_reimpacto;\n  item.json.body_mensaje   = JSON.stringify({\n    content: titulo + '\\n\\n' + item.json.textoPlantilla,\n    message_type: 'outgoing',\n    private: true,\n    inbox_id: inboxId,\n  });\n}\n\nreturn items;\n"
      },
