        "jsonBody": "{\n  \"payload\": [\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_plantilla_enviada_meta\"\n      ],\n      \"query_operator\": \"OR\"\n    },\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_reimpacto1_meta\"\n      ],\n      \"query_operator\": \"OR\"\n    },\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_reimpacto2_meta\"\n      ],\n      \"query_operator\": \"OR\"\n    },\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_reimpacto3_meta\"\n      ],\n      \"query_operator\": \"OR\"\n    },\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_reimpacto4_meta\"\n      ],\n      \"query_operator\": \"OR\"\n    },\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_reimpacto5_meta\"\n      ],\n      \"query_operator\": \"OR\"\n    },\n    {\n      \"attribute_key\": \"labels\",\n      \"filter_operator\": \"equal_to\",\n      \"values\": [\n        \"z_reimpacto6_meta\"\n      ],\n      \"query_operator\": null\n    }\n  ]\n}",
